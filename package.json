{
  "name": "folio-personal-reader",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "android": "npm run build && npx cap sync android",
    "android:init": "npm run build && npx cap add android && npx cap sync android",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "build:desktop": "vite build --mode desktop",
    "windows": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "desktop:smoke": "node desktop/smoke.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.0.0",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.4.296",
    "@capacitor/share": "^8.0.0",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "@playwright/test": "^1.56.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Folio, bibliothèque privée hors ligne PDF et EPUB pour Android et Windows",
  "author": "Folio Contributors",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "fr.folio.lecteurpersonnel",
    "productName": "Folio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/*.cjs",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Folio-Setup-${version}-${arch}.${ext}",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
